# ===============================================
# TeleStream Telegram Bot Configuration
# ===============================================

# -----------------------------------------------
# Core Bot Settings
# -----------------------------------------------
# Your Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Embedded Ktor Web Server Port (Mini App WebUI & Health check)
# 7860 is default for Hugging Face Spaces, 8080 for standard servers/VPS
PORT=7860

# Telegram Mini App Public HTTPS URL
# Used for the WebApp launch button (/app command and Telegram Menu Button).
# On Hugging Face Spaces, this is automatically derived from SPACE_HOST if omitted.
# Example: https://your-space-name.hf.space or https://telestream.yourdomain.com
WEBAPP_URL=http://localhost:7860

# -----------------------------------------------
# Access Control & Administration
# -----------------------------------------------
# Comma-separated Telegram numeric User IDs allowed to access admin commands (/admin, /sync, /addrepo, /nsfw).
# Find your numeric ID via @userinfobot on Telegram.
# If left empty, all users can administer (or set IDs to restrict access).
ADMIN_IDS=12345678,87654321

# -----------------------------------------------
# Network & Proxy Configuration (Optional)
# -----------------------------------------------
# Custom Telegram API endpoint (Useful for self-hosted Telegram Bot API Server or reverse proxy)
# Default: https://api.telegram.org
TELEGRAM_API_URL=https://api.telegram.org

# Proxy for Telegram Bot API requests (HTTP or SOCKS5)
# If not set, falls back to HTTPS_PROXY or HTTP_PROXY
# TELEGRAM_PROXY=socks5://127.0.0.1:10808
# TELEGRAM_PROXY=http://127.0.0.1:10808

# Proxy for CloudStream scrapers & media extractors (HTTP or SOCKS5)
# If not set, falls back to ALL_PROXY, HTTPS_PROXY, or HTTP_PROXY
# SCRAPER_PROXY=socks5://127.0.0.1:10808
# SCRAPER_PROXY=http://127.0.0.1:10808

# DNS-over-HTTPS (DoH) via Cloudflare (1.1.1.1) with anti-censorship fallback
# Set to 'false' to disable and use system DNS
ENABLE_DOH=true

# FlareSolverr URL for bypassing Cloudflare anti-bot protection (Optional)
# If running FlareSolverr via Docker: docker run -d --name=flaresolverr -p 8191:8191 ghcr.io/flaresolverr/flaresolverr:latest
# Default: http://localhost:8191/v1 (automatically falls back to headless HTTP if offline)
# FLARESOLVERR_URL=http://localhost:8191/v1

# -----------------------------------------------
# Crypto Donation Wallets (Optional for /donate)
# -----------------------------------------------
# TRC-20 USDT Wallet Address
DONATION_USDT_TRC20=TQn9Y2khEsLJW1ChVWFMSMeSTow5KaxnSE

# The Open Network (TON) Wallet Address
DONATION_TON=UQDP14pSjV1k8L0Fj8d2p7k8XqZ7YjB7p9

# Bitcoin (BTC) Wallet Address
DONATION_BTC=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh

# Ethereum / EVM (ERC-20) Wallet Address
DONATION_ETH=0x71C...YourEthAddressHere
